#!/bin/sh
set -eu
if [ "$#" -lt 1 ]; then printf '%s
' 'Usage: a2h-bootstrap SOURCE [TARGET]' >&2; exit 64; fi
runtime="$PWD/.hmigbot-ios/plugin"
if [ ! -f "$runtime/scripts/a2h_ios.py" ]; then
  runtime=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fi
exec "${PYTHON:-python3}" "$runtime/scripts/a2h_ios.py" init --source "$1" --project "${2:-$PWD}"
