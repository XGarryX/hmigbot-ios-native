{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hmigbot-ios/spec-artifacts/2",
  "$defs": {
    "source_disposition_entry": {"type": "object", "required": ["path", "disposition", "reason", "line", "end_line", "source_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "disposition": {"enum": ["dependency", "test", "not_applicable"]}, "reason": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of this entry file's current bytes, not the whole-source snapshot digest"}}, "description": "Every entry is consumed as a literal exclusion, so the reviewed span and this file's current byte hash are part of the contract."},
    "source_disposition": {"type": "object", "required": ["files", "source_sha256"], "properties": {"files": {"type": "array", "items": {"$ref": "#/$defs/source_disposition_entry"}}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Whole-source snapshot digest; distinct from each entry's per-file byte hash"}}, "description": "An absent file means no exclusions; a present file must bind the current whole-source digest even with an empty files list."},
    "source_anchor": {"type": "object", "required": ["path", "line"], "properties": {"path": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "symbol": {"type": "string"}, "role": {"type": "string"}}, "additionalProperties": false},
    "anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_anchor"}},
    "ac_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[0-9]+-AC[0-9]+$"}},
    "page_meta": {"type": "object", "required": ["schema_version", "spec_contract_version", "page_id", "source_platform", "frameworks", "source_refs", "source_anchors", "screenshot", "runtime"], "properties": {
      "schema_version": {"const": 1}, "spec_contract_version": {"const": 2}, "page_id": {"type": "string", "pattern": "^page_[0-9]+$"}, "source_platform": {"const": "ios"},
      "frameworks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["swiftui", "uikit", "appkit", "interface-builder", "webview", "other"]}},
      "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_anchors": {"$ref": "#/$defs/anchors"},
      "screenshot": {"type": ["string", "null"], "minLength": 1}, "runtime": {"enum": ["not_run", "captured", "verified"]},
      "source_languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "page_type": {"enum": ["full_screen_page", "modal_overlay", "dialog", "sub_component"]},
      "needs_immersive_safearea": {"type": "boolean"},
      "semantics_ref": {"type": "string", "pattern": "^spec/baseline/ios-semantics\\.json#page_[0-9]+$"},
      "state_conditions": {"type": "array", "items": {"type": ["object", "string"]}},
      "resource_refs": {"type": "array", "items": {"type": ["object", "string"]}},
      "navigation_refs": {"type": "array", "items": {"type": ["object", "string"]}},
      "extensions": {"type": "object"}
    }, "additionalProperties": false},
    "action_contract": {"type": "object", "required": ["action_id", "owner", "target", "source_anchors", "immediate_effect", "completion_event", "final_effect", "failure_cancel", "scope", "ac_ids"], "properties": {
      "action_id": {"type": "string", "pattern": "^F[0-9]+-A[0-9]+$"}, "owner": {"type": "string", "pattern": "^F[0-9]+$"}, "target": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"},
      "source_anchors": {"$ref": "#/$defs/anchors"}, "immediate_effect": {"type": "string", "minLength": 1}, "completion_event": {"type": "string", "minLength": 1}, "final_effect": {"type": "string", "minLength": 1}, "failure_cancel": {"type": "string", "minLength": 1}, "scope": {"enum": ["active", "skipped"]}, "ac_ids": {"$ref": "#/$defs/ac_ids"}, "skip_ref": {"type": "string", "minLength": 1}, "decision_ref": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "action_use": {"type": "object", "required": ["action_id", "contract_ref", "ac_ids"], "properties": {"action_id": {"type": "string", "pattern": "^F[0-9]+-A[0-9]+$"}, "contract_ref": {"type": "string", "minLength": 1}, "ac_ids": {"$ref": "#/$defs/ac_ids"}}, "additionalProperties": false},
    "api_inventory": {"type": "object", "required": ["source_platform", "services"], "properties": {"source_platform": {"const": "ios"}, "services": {"type": "array", "items": {"type": "object", "required": ["auth_type", "endpoints"], "properties": {"auth_type": {"type": "string", "minLength": 1}, "endpoints": {"type": "array", "items": {"type": "object", "required": ["static"], "properties": {"id": {"type": "string", "minLength": 1}, "static": {"type": "object", "required": ["http_method", "path", "protocol"], "properties": {"http_method": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "protocol": {"type": "string", "minLength": 1}}}}}}}}}}},
    "api_contract_links": {"type": "object", "required": ["schema_version", "source_platform", "endpoints"], "properties": {"schema_version": {"const": 1}, "source_platform": {"const": "ios"}, "endpoints": {"type": "array", "items": {"type": "object", "required": ["id", "feature_ids", "source_anchors", "contract_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "feature_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F[0-9]+$"}}, "source_anchors": {"$ref": "#/$defs/anchors"}, "contract_ref": {"type": "string", "minLength": 1}}}}}},
    "state_machine": {"type": "object", "required": ["schema_version", "source_platform", "feature_id", "contract_ref", "states", "transitions"], "properties": {"schema_version": {"const": 1}, "source_platform": {"const": "ios"}, "feature_id": {"type": "string", "pattern": "^F[0-9]+$"}, "contract_ref": {"type": "string", "minLength": 1}, "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "transitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["from", "event", "to", "ac_ids", "source_anchors"], "properties": {"from": {"type": "string", "minLength": 1}, "event": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "ac_ids": {"$ref": "#/$defs/ac_ids"}, "source_anchors": {"$ref": "#/$defs/anchors"}}}}}}
  }
}
