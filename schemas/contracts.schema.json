{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HMigBot iOS adapter contracts v1",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor": {
      "type": "object",
      "required": ["path", "sha256", "line"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "line": {"type": "integer", "minimum": 1}}
    },
    "fact": {
      "type": "object",
      "required": ["id", "kind", "value", "evidence", "source_platform", "source_anchors_ref"],
      "properties": {
        "id": {"type": "string"}, "kind": {"type": "string"}, "value": {"type": "object"},
        "evidence": {"enum": ["structured_static", "lexical_hint", "restricted_parser", "SwiftSyntax", "SwiftSyntax_AST_ArkUI_rule"]},
        "source_platform": {"const": "ios"},
        "source_anchors_ref": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/anchor"}}
      }
    },
    "facts": {
      "type": "object",
      "required": ["schema_version", "source_platform", "source_snapshot", "facts", "pages", "issues", "migration_status"],
      "properties": {
        "schema_version": {"const": "hmigbot-ios/1"}, "source_platform": {"const": "ios"},
        "source_snapshot": {"type": "object", "required": ["sha256", "files"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "files": {"type": "array"}}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "pages": {"type": "array"}, "issues": {"type": "array"}, "migration_status": {"const": "not_verified"}
      }
    },
    "config": {
      "type": "object",
      "required": ["schema_version", "source", "target"],
      "properties": {
        "schema_version": {"const": 2},
        "source": {"type": "object", "required": ["platform", "root"], "properties": {"platform": {"enum": ["ios", "android"]}, "root": {"type": "string", "minLength": 1}}},
        "target": {"type": "object", "required": ["platform", "root"], "properties": {"platform": {"const": "harmonyos"}, "root": {"type": "string", "minLength": 1}}},
        "tools": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["schema_version", "source_sha256", "kind", "provider", "origin", "claim_validation", "artifacts"],
      "properties": {
        "schema_version": {"const": "hmigbot-ios/1"}, "source_sha256": {"$ref": "#/$defs/hash"},
        "kind": {"enum": ["source_build", "source_tests", "source_scenario", "source_screenshot", "source_snapshot", "source_trace", "source_network", "source_data", "source_debug", "source_performance"]},
        "provider": {"type": "string", "minLength": 1}, "origin": {"const": "user_supplied_source_evidence"},
        "claim_validation": {"const": "not_performed"},
        "artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/config"}, {"$ref": "#/$defs/facts"}, {"$ref": "#/$defs/evidence"}]
}
