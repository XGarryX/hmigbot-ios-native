{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmigbot.local/schemas/project-source-scope.schema.json",
  "title": "Derived Xcode project product source declarations",
  "description": "All source members and exclusions are recomputed from project.pbxproj. This is not selected-build/compiler/runtime evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "project_path", "targets", "configuration", "target_closure", "source_files", "source_membership", "excluded_sources", "source_hash", "project_sha256", "evidence", "effective_build", "limitations"],
  "properties": {
    "scope": {"const": "project-targets"},
    "project_path": {"type": "string", "pattern": "^[^\\\\:]+\\.xcodeproj/project\\.pbxproj$"},
    "targets": {"$ref": "#/$defs/names"},
    "configuration": {"type": "string", "minLength": 1},
    "target_closure": {"$ref": "#/$defs/names"},
    "source_files": {"type": "array", "items": {"$ref": "#/$defs/path"}, "uniqueItems": true},
    "source_membership": {"type": "array", "items": {"$ref": "#/$defs/member"}, "uniqueItems": true},
    "excluded_sources": {"type": "array", "items": {"$ref": "#/$defs/excluded"}, "uniqueItems": true},
    "source_hash": {"$ref": "#/$defs/hash"},
    "project_sha256": {"$ref": "#/$defs/hash"},
    "evidence": {"const": "project_declared_membership"},
    "effective_build": {"const": "unresolved"},
    "limitations": {
      "const": ["headers_implicit_includes_unresolved", "conditional_build_settings_not_evaluated"]
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "targets", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "targets": {"$ref": "#/$defs/names"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "excluded": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "targets", "sha256", "reason"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "targets": {"$ref": "#/$defs/names"}, "sha256": {"$ref": "#/$defs/hash"}, "reason": {"enum": ["test_only_oracle", "outside_product_target_closure"]}}
    }
  }
}
