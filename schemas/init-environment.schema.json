{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "runtime",
    "controlled_runtime",
    "actions",
    "product_verified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "init_environment"
    },
    "status": {
      "enum": [
        "ready",
        "preparation_required"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "controlled_runtime": {
      "type": "boolean"
    },
    "actions": {
      "type": "array"
    },
    "product_verified": {
      "const": false
    }
  }
}
